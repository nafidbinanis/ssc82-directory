PORT=4000
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Postgres connection string. For local testing against a Postgres you installed
# yourself: postgres://postgres:yourpassword@localhost:5432/ssc82_directory
# For production, use the "Connection string" (URI, Transaction pooler mode)
# from your Supabase project: Settings -> Database -> Connection string.
DATABASE_URL=postgres://user:password@host:5432/database
